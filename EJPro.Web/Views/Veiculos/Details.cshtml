@model EJPro.Web.Models.Veiculo

@{
    ViewData["Title"] = "Detalhes do veículo";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h1 class="h3 mb-1">Detalhes do veículo</h1>
                        <p class="text-muted mb-0">
                            Informações cadastradas no sistema.
                        </p>
                    </div>

                    <span class="badge bg-success">
                        Ativo
                    </span>
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Proprietário</dt>
                    <dd class="col-sm-8">@Model.Cliente.NomeCompleto</dd>

                    <dt class="col-sm-4">Placa</dt>
                    <dd class="col-sm-8">
                        <strong>@Model.Placa</strong>
                    </dd>

                    <dt class="col-sm-4">Marca</dt>
                    <dd class="col-sm-8">@Model.Marca</dd>

                    <dt class="col-sm-4">Modelo</dt>
                    <dd class="col-sm-8">@Model.Modelo</dd>

                    <dt class="col-sm-4">Ano</dt>
                    <dd class="col-sm-8">
                        @(Model.Ano?.ToString() ?? "-")
                    </dd>

                    <dt class="col-sm-4">Cor</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrWhiteSpace(Model.Cor) ? "-" : Model.Cor)
                    </dd>

                    <dt class="col-sm-4">Quilometragem</dt>
                    <dd class="col-sm-8">
                        @(Model.Quilometragem.HasValue
                            ? $"{Model.Quilometragem.Value:N0} km"
                            : "-")
                    </dd>

                    <dt class="col-sm-4">Chassi</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrWhiteSpace(Model.Chassi) ? "-" : Model.Chassi)
                    </dd>

                    <dt class="col-sm-4">Observações</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrWhiteSpace(Model.Observacoes)
                            ? "-"
                            : Model.Observacoes)
                    </dd>

                    <dt class="col-sm-4">Data de cadastro</dt>
                    <dd class="col-sm-8">
                        @(Model.DataCadastro.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm"))
                    </dd>
                </dl>

                <div class="d-flex gap-2 mt-4">
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        Editar veículo
                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Voltar para a lista
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>