@model EJPro.Web.Models.Cliente

@{
    ViewData["Title"] = "Detalhes do cliente";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h1 class="h3 mb-1">Detalhes do cliente</h1>
                        <p class="text-muted mb-0">
                            Informações cadastradas no sistema.
                        </p>
                    </div>

                    <span class="badge bg-success">
                        Ativo
                    </span>
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Nome completo</dt>
                    <dd class="col-sm-8">@Model.NomeCompleto</dd>

                    <dt class="col-sm-4">CPF</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrWhiteSpace(Model.Cpf) ? "-" : Model.Cpf)
                    </dd>

                    <dt class="col-sm-4">Telefone</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrWhiteSpace(Model.Telefone) ? "-" : Model.Telefone)
                    </dd>

                    <dt class="col-sm-4">E-mail</dt>
                    <dd class="col-sm-8">
                        @if (string.IsNullOrWhiteSpace(Model.Email))
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <a href="mailto:@Model.Email">@Model.Email</a>
                        }
                    </dd>

                    <dt class="col-sm-4">Endereço</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrWhiteSpace(Model.Endereco) ? "-" : Model.Endereco)
                    </dd>

                    <dt class="col-sm-4">Observações</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrWhiteSpace(Model.Observacoes) ? "-" : Model.Observacoes)
                    </dd>

                    <dt class="col-sm-4">Data de cadastro</dt>
                    <dd class="col-sm-8">
                        @Model.DataCadastro.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")
                    </dd>
                </dl>

                <div class="d-flex gap-2 mt-4">
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        Editar cliente
                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Voltar para a lista
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>