@model IEnumerable<EJPro.Web.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Clientes</h1>
        <p class="text-muted mb-0">
            Consulte e gerencie os clientes da oficina.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Novo cliente
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nenhum cliente cadastrado.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>Telefone</th>
                    <th>E-mail</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.NomeCompleto</td>
                        <td>@(string.IsNullOrWhiteSpace(cliente.Cpf) ? "-" : cliente.Cpf)</td>
                        <td>@(string.IsNullOrWhiteSpace(cliente.Telefone) ? "-" : cliente.Telefone)</td>
                        <td>@(string.IsNullOrWhiteSpace(cliente.Email) ? "-" : cliente.Email)</td>

                        <td class="text-end">
                            <a asp-action="Details"
                               asp-route-id="@cliente.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Detalhes
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@cliente.Id"
                               class="btn btn-sm btn-outline-primary">
                                Editar
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@cliente.Id"
                               class="btn btn-sm btn-outline-danger">
                                Desativar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}