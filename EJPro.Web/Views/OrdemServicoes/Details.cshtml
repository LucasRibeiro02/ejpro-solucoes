@model EJPro.Web.Models.OrdemServico

@{
    ViewData["Title"] = "Detalhes da ordem de serviço";

    var fusoHorarioBrasil =
        TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");

    var dataAberturaUtc = DateTime.SpecifyKind(
        Model.DataAbertura,
        DateTimeKind.Utc
    );

    var dataAberturaBrasil = TimeZoneInfo.ConvertTimeFromUtc(
        dataAberturaUtc,
        fusoHorarioBrasil
    );

    DateTime? dataPrevisaoBrasil = null;

    if (Model.DataPrevisaoEntrega.HasValue)
    {
        var dataPrevisaoUtc = DateTime.SpecifyKind(
            Model.DataPrevisaoEntrega.Value,
            DateTimeKind.Utc
        );

        dataPrevisaoBrasil = TimeZoneInfo.ConvertTimeFromUtc(
            dataPrevisaoUtc,
            fusoHorarioBrasil
        );
    }

    DateTime? dataConclusaoBrasil = null;

    if (Model.DataConclusao.HasValue)
    {
        var dataConclusaoUtc = DateTime.SpecifyKind(
            Model.DataConclusao.Value,
            DateTimeKind.Utc
        );

        dataConclusaoBrasil = TimeZoneInfo.ConvertTimeFromUtc(
            dataConclusaoUtc,
            fusoHorarioBrasil
        );
    }
}

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Atendimento</h2>

                <h3 class="h6">Problema relatado</h3>
                <p class="text-break">@Model.ProblemaRelatado</p>

                <h3 class="h6 mt-4">Diagnóstico</h3>
                <p class="text-break">
                    @(string.IsNullOrWhiteSpace(Model.Diagnostico)
                        ? "Ainda não informado."
                        : Model.Diagnostico)
                </p>

                <h3 class="h6 mt-4">Serviço executado</h3>
                <p class="text-break">
                    @(string.IsNullOrWhiteSpace(Model.ServicoExecutado)
                        ? "Ainda não informado."
                        : Model.ServicoExecutado)
                </p>

                <h3 class="h6 mt-4">Observações</h3>
                <p class="text-break mb-0">
                    @(string.IsNullOrWhiteSpace(Model.Observacoes)
                        ? "-"
                        : Model.Observacoes)
                </p>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Valores</h2>

                <div class="row">
                    <div class="col-md-3">
                        <span class="text-muted d-block">Mão de obra</span>
                        <strong>@Model.ValorMaoDeObra.ToString("C")</strong>
                    </div>

                    <div class="col-md-3">
                        <span class="text-muted d-block">Peças</span>
                        <strong>@Model.ValorPecas.ToString("C")</strong>
                    </div>

                    <div class="col-md-3">
                        <span class="text-muted d-block">Desconto</span>
                        <strong>@Model.Desconto.ToString("C")</strong>
                    </div>

                    <div class="col-md-3">
                        <span class="text-muted d-block">Total</span>
                        <strong class="text-success fs-5">
                            @Model.ValorTotal.ToString("C")
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2 mt-4">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Editar ordem
    </a>

    <a asp-action="Imprimir"
       asp-route-id="@Model.Id"
       target="_blank"
       class="btn btn-outline-dark">
        Imprimir / Gerar PDF
    </a>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Voltar para a lista
    </a>
</div>