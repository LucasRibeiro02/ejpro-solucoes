@model IEnumerable<EJPro.Web.Models.OrdemServico>

@{
    ViewData["Title"] = "Ordens de serviço";
    var statusSelecionado = ViewBag.StatusSelecionado?.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Ordens de serviço</h1>
        <p class="text-muted mb-0">
            Acompanhe os atendimentos registrados na oficina.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Nova ordem de serviço
    </a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <label for="pesquisa" class="form-label">
            Pesquisar
        </label>

        <input type="text"
               id="pesquisa"
               name="pesquisa"
               value="@ViewBag.Pesquisa"
               class="form-control"
               placeholder="Número da OS, cliente, placa, marca ou modelo" />
    </div>

    <div class="col-md-4">
        <label for="status" class="form-label">
            Situação
        </label>

        <select id="status" name="status" class="form-select">
            <option value="">Todas as situações</option>
            <option value="Aberta"
                    selected="@(statusSelecionado == "Aberta")">
                Aberta
            </option>
            <option value="EmDiagnostico"
                    selected="@(statusSelecionado == "EmDiagnostico")">
                Em diagnóstico
            </option>
            <option value="AguardandoAprovacao"
                    selected="@(statusSelecionado == "AguardandoAprovacao")">
                Aguardando aprovação
            </option>
            <option value="EmExecucao"
                    selected="@(statusSelecionado == "EmExecucao")">
                Em execução
            </option>
            <option value="Finalizada"
                    selected="@(statusSelecionado == "Finalizada")">
                Finalizada
            </option>
            <option value="Entregue"
                    selected="@(statusSelecionado == "Entregue")">
                Entregue
            </option>
            <option value="Cancelada"
                    selected="@(statusSelecionado == "Cancelada")">
                Cancelada
            </option>
        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">
            Filtrar
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Limpar
        </a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info mb-4">
        Nenhuma ordem de serviço foi encontrada com os filtros informados.
    </div>
}
else
{
    <p class="text-muted mb-3">
        @Model.Count()
        @(Model.Count() == 1
            ? "ordem de serviço encontrada"
            : "ordens de serviço encontradas")
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>OS</th>
                    <th>Abertura</th>
                    <th>Veículo</th>
                    <th>Cliente</th>
                    <th>Situação</th>
                    <th>Total</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var ordem in Model)
                {
                    var statusTexto = ordem.Status switch
                    {
                        StatusOrdemServico.Aberta => "Aberta",
                        StatusOrdemServico.EmDiagnostico => "Em diagnóstico",
                        StatusOrdemServico.AguardandoAprovacao => "Aguardando aprovação",
                        StatusOrdemServico.EmExecucao => "Em execução",
                        StatusOrdemServico.Finalizada => "Finalizada",
                        StatusOrdemServico.Entregue => "Entregue",
                        StatusOrdemServico.Cancelada => "Cancelada",
                        _ => ordem.Status.ToString()
                    };

                    var statusClasse = ordem.Status switch
                    {
                        StatusOrdemServico.Aberta => "bg-primary",
                        StatusOrdemServico.EmDiagnostico => "bg-info text-dark",
                        StatusOrdemServico.AguardandoAprovacao => "bg-warning text-dark",
                        StatusOrdemServico.EmExecucao => "bg-secondary",
                        StatusOrdemServico.Finalizada => "bg-success",
                        StatusOrdemServico.Entregue => "bg-dark",
                        StatusOrdemServico.Cancelada => "bg-danger",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td>
                            <strong>#@ordem.Id.ToString("D5")</strong>
                        </td>

                        <td>
                            @(ordem.DataAbertura.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                        </td>

                        <td>
                            <strong>@ordem.Veiculo.Placa</strong><br />
                            <small class="text-muted">
                                @ordem.Veiculo.Marca @ordem.Veiculo.Modelo
                            </small>
                        </td>

                        <td>@ordem.Veiculo.Cliente.NomeCompleto</td>

                        <td>
                            <span class="badge @statusClasse">
                                @statusTexto
                            </span>
                        </td>

                        <td>
                            @ordem.ValorTotal.ToString("C")
                        </td>

                        <td class="text-end">
                            <a asp-action="Details"
                               asp-route-id="@ordem.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Detalhes
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@ordem.Id"
                               class="btn btn-sm btn-outline-primary">
                                Editar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}