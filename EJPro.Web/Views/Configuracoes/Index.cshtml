@model EJPro.Web.Models.ConfiguracaoOficina

@{
    ViewData["Title"] = "Configurações da oficina";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">Configurações da oficina</h1>
                <p class="text-muted mb-0">
                    Dados utilizados no sistema e nas ordens de serviço.
                </p>
            </div>
        </div>

        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Sucesso"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Salvar" method="post">
                    @Html.AntiForgeryToken()

                    <input asp-for="Id" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"></div>

                    <h2 class="h5 mb-3">Dados da oficina</h2>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="NomeOficina" class="form-label"></label>
                            <input asp-for="NomeOficina" class="form-control" />
                            <span asp-validation-for="NomeOficina"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Documento" class="form-label"></label>
                            <input asp-for="Documento"
                                   class="form-control"
                                   placeholder="CPF ou CNPJ" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Telefone" class="form-label"></label>
                            <input asp-for="Telefone"
                                   class="form-control"
                                   placeholder="(00) 0000-0000" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="WhatsApp" class="form-label"></label>
                            <input asp-for="WhatsApp"
                                   class="form-control"
                                   placeholder="(00) 00000-0000" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="contato@oficina.com.br" />
                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Endereco" class="form-label"></label>
                            <input asp-for="Endereco"
                                   class="form-control"
                                   placeholder="Rua, número e bairro" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Cep" class="form-label"></label>
                            <input asp-for="Cep"
                                   class="form-control"
                                   placeholder="00000-000" />
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Cidade" class="form-label"></label>
                            <input asp-for="Cidade" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Estado" class="form-label"></label>
                            <input asp-for="Estado"
                                   class="form-control text-uppercase"
                                   maxlength="2"
                                   placeholder="SP" />
                        </div>

                        <div class="col-12">
                            <label asp-for="LogoUrl" class="form-label"></label>
                            <input asp-for="LogoUrl"
                                   class="form-control"
                                   placeholder="/images/logo.png" />
                            <div class="form-text">
                                Caminho da imagem dentro da pasta wwwroot.
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <h2 class="h5 mb-3">Dados para pagamento via PIX</h2>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="TipoChavePix" class="form-label"></label>
                            <select asp-for="TipoChavePix" class="form-select">
                                <option value="">Selecione</option>
                                <option value="CPF">CPF</option>
                                <option value="CNPJ">CNPJ</option>
                                <option value="Telefone">Telefone</option>
                                <option value="E-mail">E-mail</option>
                                <option value="Chave aleatória">Chave aleatória</option>
                            </select>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="ChavePix" class="form-label"></label>
                            <input asp-for="ChavePix"
                                   class="form-control"
                                   placeholder="Informe a chave PIX" />
                        </div>

                        <div class="col-md-8">
                            <label asp-for="BeneficiarioPix" class="form-label"></label>
                            <input asp-for="BeneficiarioPix"
                                   class="form-control"
                                   placeholder="Nome do beneficiário" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CidadePix" class="form-label"></label>
                            <input asp-for="CidadePix"
                                   class="form-control"
                                   placeholder="Cidade" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-primary px-4">
                            Salvar configurações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}