@{
    var controllerAtual =
        ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EJPro.Web</title>
    <script>
        (() => {
            const temaSalvo = localStorage.getItem("ejpro-tema");
            const prefereEscuro = window.matchMedia("(prefers-color-scheme: dark)").matches;
            const temaInicial = temaSalvo ?? (prefereEscuro ? "dark" : "light");

            document.documentElement.setAttribute("data-bs-theme", temaInicial);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EJPro.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark navbar-ejpro border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2"
                   asp-controller="Home"
                   asp-action="Index">
                    <img src="~/images/logo-ejpro.png"
                         alt="Logo E&amp;J PRO Soluções"
                         class="logo-navbar" />

                    <span class="fw-semibold">E&amp;J PRO</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controllerAtual == "Home" ? "active" : "")"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Início
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(controllerAtual == "Clientes" ? "active" : "")"
                                   asp-controller="Clientes"
                                   asp-action="Index">
                                    Clientes
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(controllerAtual == "Veiculos" ? "active" : "")"
                                   asp-controller="Veiculos"
                                   asp-action="Index">
                                    Veículos
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(controllerAtual == "OrdemServicoes" ? "active" : "")"
                                   asp-controller="OrdemServicoes"
                                   asp-action="Index">
                                    Ordens de Serviço
                                </a>
                            </li>
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link
                                            @(controllerAtual == "Usuarios" ? "active" : "")"
                                       asp-controller="Usuarios"
                                       asp-action="Criar">
                                        Usuários
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Configuracoes"
                                       asp-action="Index">
                                        Configurações
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                        
                    <div class="d-flex align-items-center gap-2">
                        <button type="button"
                                id="botaoTema"
                                class="btn btn-tema"
                                aria-label="Alternar entre modo claro e escuro"
                                title="Alterar tema">
                            <span id="iconeTema" aria-hidden="true">☾</span>
                        </button>

                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>
    </header>
    <div class="container page-container">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            &copy; 2026 — E&amp;J PRO Soluções
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const botaoTema = document.getElementById("botaoTema");
            const iconeTema = document.getElementById("iconeTema");

            if (!botaoTema || !iconeTema) {
                return;
            }

            function atualizarIcone() {
                const temaAtual =
                    document.documentElement.getAttribute("data-bs-theme");

                iconeTema.textContent = temaAtual === "dark" ? "☀" : "☾";
                botaoTema.title =
                    temaAtual === "dark"
                        ? "Ativar modo claro"
                        : "Ativar modo escuro";
            }

            botaoTema.addEventListener("click", () => {
                const temaAtual =
                    document.documentElement.getAttribute("data-bs-theme");

                const novoTema = temaAtual === "dark" ? "light" : "dark";

                document.documentElement.setAttribute(
                    "data-bs-theme",
                    novoTema
                );

                localStorage.setItem("ejpro-tema", novoTema);
                atualizarIcone();
            });

            atualizarIcone();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
