@page
@model EJPro.Web.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Entrar";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <img src="~/images/logo-ejpro.png"
                         alt="Logo E&amp;J PRO Soluções"
                         class="logo-login mb-3" />
                    <h1 class="h3">E&amp;J PRO Soluções</h1>
                    <p class="text-muted mb-0">
                        Entre para acessar o sistema.
                    </p>
                </div>

                <form method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email"
                               class="form-label">
                            E-mail
                        </label>

                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               placeholder="usuario@exemplo.com" />

                        <span asp-validation-for="Input.Email"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password"
                               class="form-label">
                            Senha
                        </label>

                        <input asp-for="Input.Password"
                               class="form-control"
                               autocomplete="current-password"
                               placeholder="Digite sua senha" />

                        <span asp-validation-for="Input.Password"
                              class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Input.RememberMe"
                               class="form-check-input" />

                        <label asp-for="Input.RememberMe"
                               class="form-check-label">
                            Manter conectado
                        </label>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Entrar
                    </button>
                </form>

                <div class="text-center mt-3">
                    <small class="text-muted">
                        Caso não tenha acesso, procure o administrador.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}